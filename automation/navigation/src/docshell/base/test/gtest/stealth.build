# The gtests of the engine's own navigation code: the state of a planned
# navigation's "after", the load identifier a LoadInfo and its copies carry, and
# the attributes of a fresh docshell. One line in moz.build includes this file.

SOURCES += [
    "TestStealthNavigation.cpp",
]

LOCAL_INCLUDES += [
    "/docshell/base",
]

++#if DETECT_ARCH_AARCH64
++/* Firefox's bundled lavapipe: x86-64's minps and maxps run under DAZ, read a
++ * subnormal operand as a zero of its sign and return that zero. A select on
++ * AArch64 returns the subnormal itself, so the operands are flushed first. */
++static LLVMValueRef
++lp_build_daz(struct lp_build_context *bld, LLVMValueRef a)
++{
++   LLVMBuilderRef builder = bld->gallivm->builder;
++   struct lp_type itype = lp_int_type(bld->type);
++   bool wide = bld->type.width == 64;
++   LLVMValueRef ia = LLVMBuildBitCast(builder, a, lp_build_int_vec_type(bld->gallivm, bld->type), "");
++   LLVMValueRef exp = LLVMBuildAnd(builder, ia, lp_build_const_int_vec(bld->gallivm, itype,
++                                   wide ? 0x7ff0000000000000ll : 0x7f800000ll), "");
++   LLVMValueRef sub = LLVMBuildICmp(builder, LLVMIntEQ, exp, lp_build_const_int_vec(bld->gallivm, itype, 0), "");
++   LLVMValueRef sign = LLVMBuildAnd(builder, ia, lp_build_const_int_vec(bld->gallivm, itype,
++                                    wide ? (long long)0x8000000000000000ull : 0x80000000ll), "");
++   return LLVMBuildBitCast(builder, LLVMBuildSelect(builder, sub, sign, ia, ""), bld->vec_type, "");
++}
++
++/* minps (less) or maxps (greater) as x86-64 computes them, NaN handling included. */
++static LLVMValueRef
++lp_build_minmax_x86(struct lp_build_context *bld, LLVMValueRef a, LLVMValueRef b,
++                    enum pipe_compare_func func, enum gallivm_nan_behavior nan_behavior)
++{
++   LLVMValueRef a0 = lp_build_daz(bld, a), b0 = lp_build_daz(bld, b);
++   LLVMValueRef res = lp_build_select(bld, lp_build_cmp_ordered(bld, func, a0, b0), a0, b0);
++   if (nan_behavior == GALLIVM_NAN_RETURN_OTHER)
++      return lp_build_select(bld, lp_build_isnan(bld, b), a, res);
++   return res;
++}
++#endif
++

+@@ -317,7 +317,11 @@ void
+ lp_build_fill_mattrs(std::vector<std::string> &MAttrs)
+ {
+ 
+-#if DETECT_ARCH_ARM || DETECT_ARCH_AARCH64
++#if DETECT_ARCH_AARCH64
++   /* Firefox's bundled lavapipe: no host feature (SVE, dotprod, ...) reaches
++    * the code generator. The target's baseline, ARMv8.0 with NEON, is all it
++    * is given, whatever the CPU. */
++#elif DETECT_ARCH_ARM
+    /* llvm-3.3+ implements sys::getHostCPUFeatures for Arm,
+     * which allows us to enable/disable code generation based
+     * on the results of cpuid on these architectures.
+@@ -563,6 +567,8 @@ lp_build_create_jit_compiler_for_module(LLVMExecutionEngineRef *OutJIT,
+ #if DETECT_ARCH_X86_64
+    /* Firefox's bundled lavapipe: the baseline, never the host's CPU model. */
+    StringRef MCPU = "x86-64";
++#elif DETECT_ARCH_AARCH64
++   StringRef MCPU = "generic";
+ #else
+    StringRef MCPU = llvm::sys::getHostCPUName();
+ #endif

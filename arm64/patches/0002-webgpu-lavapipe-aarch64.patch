diff --git a/scripts/ci/lavapipe/0009-gallivm-aarch64-fixed-profile.patch b/scripts/ci/lavapipe/0009-gallivm-aarch64-fixed-profile.patch
new file mode 100644
index 0000000000..9990d872e1
--- /dev/null
+++ b/scripts/ci/lavapipe/0009-gallivm-aarch64-fixed-profile.patch
@@ -0,0 +1,39 @@
+diff --git a/src/gallium/auxiliary/gallivm/lp_bld_init_orc.cpp b/src/gallium/auxiliary/gallivm/lp_bld_init_orc.cpp
+index 62b462d..4471e4b 100644
+--- a/src/gallium/auxiliary/gallivm/lp_bld_init_orc.cpp
++++ b/src/gallium/auxiliary/gallivm/lp_bld_init_orc.cpp
+@@ -450,6 +450,8 @@ llvm::orc::JITTargetMachineBuilder LPJit::create_jtdb() {
+ #if DETECT_ARCH_X86_64
+    /* Firefox's bundled lavapipe: the baseline, never the host's CPU model. */
+    std::string MCPU = "x86-64";
++#elif DETECT_ARCH_AARCH64
++   std::string MCPU = "generic";
+ #else
+    std::string MCPU = llvm::sys::getHostCPUName().str();
+ #endif
+diff --git a/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp b/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp
+index 0ddef16..f50642e 100644
+--- a/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp
++++ b/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp
+@@ -317,7 +317,11 @@ void
+ lp_build_fill_mattrs(std::vector<std::string> &MAttrs)
+ {
+ 
+-#if DETECT_ARCH_ARM || DETECT_ARCH_AARCH64
++#if DETECT_ARCH_AARCH64
++   /* Firefox's bundled lavapipe: no host feature (SVE, dotprod, ...) reaches
++    * the code generator. The target's baseline, ARMv8.0 with NEON, is all it
++    * is given, whatever the CPU. */
++#elif DETECT_ARCH_ARM
+    /* llvm-3.3+ implements sys::getHostCPUFeatures for Arm,
+     * which allows us to enable/disable code generation based
+     * on the results of cpuid on these architectures.
+@@ -563,6 +567,8 @@ lp_build_create_jit_compiler_for_module(LLVMExecutionEngineRef *OutJIT,
+ #if DETECT_ARCH_X86_64
+    /* Firefox's bundled lavapipe: the baseline, never the host's CPU model. */
+    StringRef MCPU = "x86-64";
++#elif DETECT_ARCH_AARCH64
++   StringRef MCPU = "generic";
+ #else
+    StringRef MCPU = llvm::sys::getHostCPUName();
+ #endif
diff --git a/scripts/ci/lavapipe_build.py b/scripts/ci/lavapipe_build.py
index 27b8230d95..9e3373a283 100644
--- a/scripts/ci/lavapipe_build.py
+++ b/scripts/ci/lavapipe_build.py
@@ -40,6 +40,7 @@ import hashlib
 import io
 import json
 import os
+import platform
 import re
 import shutil
 import subprocess
@@ -58,17 +59,22 @@ PATCHES = HERE / "lavapipe"
 # patch 0008 raises: every build runs it before the library is kept.
 PROOF = PATCHES / "proof"
 VERSIONS = PATCHES / "VERSIONS.json"
+# The machine it is built on: x86_64, or aarch64 for the linux-arm64 leg.
+ARM64 = platform.machine() == "aarch64"
+MULTIARCH = "aarch64-linux-gnu" if ARM64 else "x86_64-linux-gnu"
 LIB = "libvulkan_lvp.so"
 SONAME = "libvulkan.so.1"
 EXPORTS = ("vkGetInstanceProcAddr", "vk_icdGetInstanceProcAddr")
 # What the library may link against: the C runtime, nothing of the host's.
 NEEDED_OK = {"libc.so.6", "libm.so.6", "libdl.so.2", "libpthread.so.0", "librt.so.1",
-             "ld-linux-x86-64.so.2"}
+             "ld-linux-aarch64.so.1" if ARM64 else "ld-linux-x86-64.so.2"}
 # Firefox's own floors for x86_64 (python/mozbuild/mozbuild/action/check_binary.py).
 FLOORS = {"GLIBC": (2, 17), "GLIBCXX": (3, 4, 19), "CXXABI": (1, 3, 7), "GCC": (4, 8)}
+if ARM64:  # and for arm64, from the same file
+    FLOORS = {"GLIBC": (2, 28), "GLIBCXX": (3, 4, 22), "CXXABI": (1, 3, 10), "GCC": (4, 8)}
 
 LLVM_CMAKE = [
-    "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DLLVM_TARGETS_TO_BUILD=X86",
+    "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DLLVM_TARGETS_TO_BUILD=%s" % ("AArch64" if ARM64 else "X86"),
     "-DLLVM_ENABLE_PROJECTS=", "-DLLVM_ENABLE_RUNTIMES=", "-DBUILD_SHARED_LIBS=OFF",
     "-DLLVM_BUILD_LLVM_DYLIB=OFF", "-DLLVM_LINK_LLVM_DYLIB=OFF", "-DLLVM_ENABLE_PIC=ON",
     "-DLLVM_INCLUDE_TESTS=OFF", "-DLLVM_INCLUDE_EXAMPLES=OFF", "-DLLVM_INCLUDE_BENCHMARKS=OFF",
@@ -244,7 +250,7 @@ def build(out: Path, clang: Path, sysroot: Path, jobs: int, run=subprocess.run,
     env = dict(os.environ, SOURCE_DATE_EPOCH="1767225600")
     # Nothing of the runner's: pkg-config sees the sysroot only.
     env["PKG_CONFIG_LIBDIR"] = ":".join(str(sysroot / d) for d in (
-        "usr/lib/x86_64-linux-gnu/pkgconfig", "usr/lib/pkgconfig", "usr/share/pkgconfig"))
+        "usr/lib/%s/pkgconfig" % MULTIARCH, "usr/lib/pkgconfig", "usr/share/pkgconfig"))
     env["PKG_CONFIG_SYSROOT_DIR"] = str(sysroot)
     for var in [v for v in env if v.startswith(("LP_", "GALLIUM_", "GALLIVM_", "MESA_", "VK_"))]:
         env.pop(var)
@@ -331,7 +337,7 @@ def build(out: Path, clang: Path, sysroot: Path, jobs: int, run=subprocess.run,
 def main(argv=None) -> int:
     ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
     ap.add_argument("--clang", type=Path, default=Path.home() / ".mozbuild" / "clang")
-    ap.add_argument("--sysroot", type=Path, default=Path.home() / ".mozbuild" / "sysroot-x86_64-linux-gnu")
+    ap.add_argument("--sysroot", type=Path, default=Path.home() / ".mozbuild" / ("sysroot-%s" % MULTIARCH))
     ap.add_argument("--out", type=Path)
     ap.add_argument("--jobs", type=int, default=os.cpu_count() or 4)
     ap.add_argument("--key", action="store_true", help="print the inputs key and exit")
diff --git a/scripts/ci/package_linux.sh b/scripts/ci/package_linux.sh
index 22ae75ff7b..cd8f0dc4be 100644
--- a/scripts/ci/package_linux.sh
+++ b/scripts/ci/package_linux.sh
@@ -19,8 +19,8 @@ N=$(find "$STAGING" -type l | wc -l)
 [ "$N" -eq 0 ] || { echo "ERROR: $N symlinks remain after cp -aL"; exit 1; }
 # WebGPU's Vulkan driver (scripts/ci/lavapipe_build.py), next to libxul where
 # the engine looks for it. Required: without it WebGPU answers null, never with a
-# host driver.
-if [ "${CI_LEG:-}" = linux-x86_64 ]; then
+# host driver. linux-arm64 ships its own, built natively.
+if [ "${CI_LEG:-}" = linux-x86_64 ] || [ "${CI_LEG:-}" = linux-arm64 ]; then
   [ -f obj-rel/dist/bin/lavapipe/libvulkan_lvp.so ] || { echo "ERROR: no lavapipe in obj-rel/dist/bin"; exit 1; }
   mkdir -p "$STAGING/lavapipe"
   cp -a obj-rel/dist/bin/lavapipe/libvulkan_lvp.so obj-rel/dist/bin/lavapipe/VERSION.json "$STAGING/lavapipe/"

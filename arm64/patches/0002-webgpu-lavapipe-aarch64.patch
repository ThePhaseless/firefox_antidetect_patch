+@@ -450,6 +450,8 @@ llvm::orc::JITTargetMachineBuilder LPJit::create_jtdb() {
+ #if DETECT_ARCH_X86_64
+    /* Firefox's bundled lavapipe: the baseline, never the host's CPU model. */

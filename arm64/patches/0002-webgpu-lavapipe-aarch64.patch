+@@ -228,10 +265,17 @@ lp_build_fmuladd(LLVMBuilderRef builder,
+    assert(type == LLVMTypeOf(b));
+    assert(type == LLVMTypeOf(c));
+ 
++#if DETECT_ARCH_AARCH64
++   /* Firefox's bundled lavapipe: AArch64 lowers llvm.fmuladd to a fused
++    * multiply-add, x86-64 without FMA to a multiply and an add. The
++    * multiply and the add, unfused, give the bytes x86-64 gives. */
++   return LLVMBuildFAdd(builder, LLVMBuildFMul(builder, a, b, ""), c, "");
++#else
+    char intrinsic[32];
+    lp_format_intrinsic(intrinsic, sizeof intrinsic, "llvm.fmuladd", type);
+    LLVMValueRef args[] = { a, b, c };
+    return lp_build_intrinsic(builder, intrinsic, type, args, 3, 0);
++#endif
+ }
+ 
+ 
+@@ -257,6 +301,11 @@ lp_build_max_simple(struct lp_build_context *bld,
+ 
+    /* TODO: optimize the constant case */
+ 
++#if DETECT_ARCH_AARCH64
++   if (type.floating && (type.width == 32 || type.width == 64))
++      return lp_build_minmax_x86(bld, a, b, PIPE_FUNC_GREATER, nan_behavior);
++#endif
++
+    if (type.floating && util_get_cpu_caps()->has_sse) {
+       if (type.width == 32) {
+          if (type.length == 1) {

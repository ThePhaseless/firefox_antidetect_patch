 naga/src/back/spv/writer.rs               |  10 +
 naga/tests/naga/main.rs                   |   1 +
 naga/tests/naga/spirv_external_texture.rs | 297 ++++++++++++++++++++++
 4 files changed, 317 insertions(+), 30 deletions(-)
 create mode 100644 naga/tests/naga/spirv_external_texture.rs


+/// `textureSampleBaseClampToEdge`, `textureLoad` and `textureDimensions` on a
+/// `texture_external` function parameter, and forwarding the parameter.
+#[test]
+fn external_texture_parameter() {
+    let spv = compile(TEXTURE_EXTERNAL_ARGUMENT);
+    spv.assert_well_typed();
+}
+
+/// Passing a `texture_external` global to a function.
+#[test]
+fn external_texture_global_argument() {
+    let spv = compile(TEXTURE_EXTERNAL);
+    spv.assert_well_typed();
+}
+
 /// A `texture_external` global that is only ever forwarded, never sampled.
 #[test]
 fn external_texture_forward_only() {

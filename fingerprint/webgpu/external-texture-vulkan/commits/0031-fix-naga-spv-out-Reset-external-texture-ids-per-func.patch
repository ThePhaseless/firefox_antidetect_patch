From: feder-cr <85809106+feder-cr@users.noreply.github.com>
Date: Sun, 1 Nov 2026 10:10:41 +0700
Subject: [PATCH] fix(naga spv-out): Reset external texture ids per function,
 return errors

`GlobalVariable::reset_for_function` was applied to `global_variables`
but not to the planes and parameters in `external_textures`, so a function
passing on an external texture global whose prelude didn't load it would
silently reuse the parameters id loaded by a previously written function.
Reset them too, and return `Error::Validation` instead of panicking when
the parameters are not loaded, or when an external texture call argument
is neither a global nor a function argument.

`Function::parameter_id`'s check that the argument maps to a single
parameter becomes a `debug_assert_eq!`.
---
 naga/src/back/spv/block.rs                | 11 +--
 naga/src/back/spv/mod.rs                  | 12 +++-
 naga/src/back/spv/writer.rs               |  3 +
 naga/tests/naga/spirv_external_texture.rs | 82 +++++++++++++++++++++++
 4 files changed, 102 insertions(+), 6 deletions(-)

diff --git a/naga/src/back/spv/block.rs b/naga/src/back/spv/block.rs
index 5223555a4..3edf4fd58 100644
--- a/naga/src/back/spv/block.rs
+++ b/naga/src/back/spv/block.rs
@@ -3549,10 +3549,11 @@ impl BlockContext<'_> {
                 // already loaded them from the std140-compatible uniform buffer
                 // and converted them to the regular parameters type.
                 let params_id = external_texture.params.handle_id;
-                assert_ne!(
-                    params_id, 0,
-                    "external texture parameters not loaded in the function prelude"
-                );
+                if params_id == 0 {
+                    return Err(Error::Validation(
+                        "external texture global passed to a function that doesn't use it",
+                    ));
+                }
 
                 // The planes are passed as pointers, like any texture global.
                 self.temp_list.extend_from_slice(&plane_ids);
@@ -3567,7 +3568,7 @@ impl BlockContext<'_> {
                         .push(parameter.instruction.result_id.unwrap());
                 }
             }
-            ref other => unreachable!("Unexpected external texture expression {:?}", other),
+            _ => return Err(Error::Validation("unexpected external texture expression")),
         }
         Ok(())
     }
diff --git a/naga/src/back/spv/mod.rs b/naga/src/back/spv/mod.rs
index 77be4dea6..f658e8d66 100644
--- a/naga/src/back/spv/mod.rs
+++ b/naga/src/back/spv/mod.rs
@@ -334,7 +334,7 @@ impl Function {
                     .parameter_offsets
                     .get(index as usize + 1)
                     .map_or(self.parameters.len(), |&end| end as usize);
-                assert_eq!(
+                debug_assert_eq!(
                     end - offset,
                     1,
                     "argument {index} is an external texture, which has no single parameter id"
@@ -837,6 +837,16 @@ struct ExternalTexture {
     params: GlobalVariable,
 }
 
+impl ExternalTexture {
+    /// Prepare `self` for use within a single function.
+    fn reset_for_function(&mut self) {
+        for plane in self.planes.iter_mut() {
+            plane.reset_for_function();
+        }
+        self.params.reset_for_function();
+    }
+}
+
 struct FunctionArgument {
     /// Actual instruction of the argument.
     instruction: Instruction,

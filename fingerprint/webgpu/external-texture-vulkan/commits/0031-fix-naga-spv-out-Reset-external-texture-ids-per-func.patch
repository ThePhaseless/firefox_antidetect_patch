diff --git a/naga/tests/naga/spirv_external_texture.rs b/naga/tests/naga/spirv_external_texture.rs
index 222fd4d91..18e7260b6 100644
--- a/naga/tests/naga/spirv_external_texture.rs
+++ b/naga/tests/naga/spirv_external_texture.rs
@@ -778,3 +778,85 @@ fn external_texture_no_dead_plane_loads() {
         }
     }
 }
+
+/// Compile `source` after replacing the argument of the entry point's first
+/// call with `replacement`, simulating invalid IR, and with fake bindings.
+fn compile_with_replaced_call_argument(
+    source: &str,
+    replacement: impl FnOnce(&naga::Module) -> naga::Expression,
+) -> std::thread::Result<Result<Vec<u32>, spv::Error>> {
+    let mut module = naga::front::wgsl::parse_str(source).unwrap();
+    let info = naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::TEXTURE_EXTERNAL,
+    )
+    .validate(&module)
+    .expect("validation failed");
+    let expression = replacement(&module);
+    let function = &mut module.entry_points[0].function;
+    let argument = function
+        .body
+        .iter()
+        .find_map(|statement| match *statement {
+            naga::Statement::Call { ref arguments, .. } => Some(arguments[0]),
+            _ => None,
+        })
+        .expect("no call in the entry point");
+    function.expressions[argument] = expression;
+    let options = options(spv::BindingMap::default(), true);
+    std::panic::catch_unwind(move || spv::write_vec(&module, &info, &options, None))
+}
+
+/// The parameters of an external texture global are loaded by the prelude of
+/// each function that uses it. If a function somehow passes on a global it
+/// doesn't use, this must be an error, not a reuse of the id loaded by
+/// another function.
+#[test]
+fn external_texture_no_stale_params_id() {
+    let source = "
+        @group(0) @binding(0) var tex: texture_external;
+        @group(1) @binding(0) var tex2: texture_external;
+        fn f(t: texture_external) -> u32 { return 0u; }
+        @compute @workgroup_size(1)
+        fn main() { _ = f(tex); }
+        fn uses_tex2() -> u32 { return f(tex2); }
+    ";
+    let result = compile_with_replaced_call_argument(source, |module| {
+        let (tex2, _) = module
+            .global_variables
+            .iter()
+            .find(|(_, var)| var.name.as_deref() == Some("tex2"))
+            .unwrap();
+        naga::Expression::GlobalVariable(tex2)
+    });
+    match result {
+        Ok(Err(spv::Error::Validation(_))) => {}
+        Ok(Err(other)) => panic!("expected a validation error, got {other:?}"),
+        Ok(Ok(words)) => panic!(
+            "expected a validation error, got a module:\n{}",
+            Spv::new(words).type_errors().join("\n")
+        ),
+        Err(_) => panic!("SPIR-V writer panicked"),
+    }
+}
+
+/// An external texture call argument that is neither a global nor a function
+/// argument is an error, not a panic.
+#[test]
+fn external_texture_unexpected_call_argument() {
+    let source = "
+        @group(0) @binding(0) var tex: texture_external;
+        fn f(t: texture_external) -> u32 { return 0u; }
+        @compute @workgroup_size(1)
+        fn main() { _ = f(tex); }
+    ";
+    let result = compile_with_replaced_call_argument(source, |module| {
+        let (_, tex) = module.global_variables.iter().next().unwrap();
+        naga::Expression::ZeroValue(tex.ty)
+    });
+    match result {
+        Ok(Err(spv::Error::Validation(_))) => {}
+        Ok(other) => panic!("expected a validation error, got {other:?}"),
+        Err(_) => panic!("SPIR-V writer panicked"),
+    }
+}

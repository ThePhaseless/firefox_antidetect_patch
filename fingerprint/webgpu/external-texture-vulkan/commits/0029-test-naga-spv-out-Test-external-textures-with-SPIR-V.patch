From: feder-cr <85809106+feder-cr@users.noreply.github.com>
Date: Sun, 1 Nov 2026 10:07:09 +0700
Subject: [PATCH] test(naga spv-out): Test external textures with SPIR-V 1.4
 and single entry points

Check that the size query splats its `OpSelect` condition, that SPIR-V
1.4 and 1.5 entry point interfaces list the external texture planes and
parameters, and that writing a single entry point (as wgpu does) produces
a well-typed module.
---
 naga/tests/naga/spirv_external_texture.rs | 112 +++++++++++++++++++++-
 1 file changed, 111 insertions(+), 1 deletion(-)

diff --git a/naga/tests/naga/spirv_external_texture.rs b/naga/tests/naga/spirv_external_texture.rs
index cace3de08..3fd02f786 100644
--- a/naga/tests/naga/spirv_external_texture.rs
+++ b/naga/tests/naga/spirv_external_texture.rs
@@ -69,6 +69,14 @@ fn options(binding_map: spv::BindingMap, fake_missing_bindings: bool) -> spv::Op
 }
 
 fn try_compile(source: &str, options: &spv::Options) -> Result<Vec<u32>, spv::Error> {
+    try_compile_pipeline(source, options, None)
+}
+
+fn try_compile_pipeline(
+    source: &str,
+    options: &spv::Options,
+    pipeline_options: Option<&spv::PipelineOptions>,
+) -> Result<Vec<u32>, spv::Error> {
     let module = naga::front::wgsl::parse_str(source)
         .unwrap_or_else(|e| panic!("WGSL parse failed:\n{}", e.emit_to_string(source)));
     let info = naga::valid::Validator::new(
@@ -77,7 +85,7 @@ fn try_compile(source: &str, options: &spv::Options) -> Result<Vec<u32>, spv::Er
     )
     .validate(&module)
     .expect("validation failed");
-    spv::write_vec(&module, &info, options, None)
+    spv::write_vec(&module, &info, options, pipeline_options)
 }
 
 fn compile(source: &str) -> Spv {
@@ -633,3 +641,105 @@ fn external_texture_load_plane0_coords_saturate() {
     assert_eq!(spv.ext_op(spv.def(rounded)), Some(GLSL_ROUND_EVEN));
     assert_eq!(spv.def(zero).class.opcode, Op::ConstantNull);
 }
+
+/// `OpSelect` with a scalar condition and vector operands requires SPIR-V
+/// 1.4, so the size query splats `any(params.size != 0)`.
+#[test]
+fn external_texture_size_query_select() {
+    let spv = compile(TEXTURE_EXTERNAL);
+    let function = spv.function("naga_external_texture_size_query");
+    let selects: Vec<&Instruction> = spv
+        .instructions(function)
+        .filter(|inst| inst.class.opcode == Op::Select)
+        .collect();
+    let [select] = selects[..] else {
+        panic!("expected one OpSelect");
+    };
+    let condition = spv.def(id(&select.operands[0]));
+    assert_eq!(condition.class.opcode, Op::CompositeConstruct);
+    let [x, y] = &condition.operands[..] else {
+        panic!("expected a two-component condition");
+    };
+    assert_eq!(x, y);
+    assert_eq!(spv.def(id(x)).class.opcode, Op::Any);
+}
+
+/// The ids of the module's variables that have a `Binding` decoration.
+fn resource_variables(spv: &Spv) -> Vec<Word> {
+    let mut variables: Vec<Word> = spv
+        .module
+        .annotations
+        .iter()
+        .filter(|inst| {
+            inst.class.opcode == Op::Decorate
+                && inst.operands[1] == Operand::Decoration(spirv::Decoration::Binding)
+        })
+        .map(|inst| id(&inst.operands[0]))
+        .collect();
+    variables.sort();
+    variables
+}
+
+/// From SPIR-V 1.4 on, entry point interfaces list every global variable the
+/// entry point uses, including the planes and parameters of external
+/// textures.
+#[test]
+fn external_texture_spirv_1_4() {
+    for source in [
+        TEXTURE_EXTERNAL,
+        TEXTURE_EXTERNAL_ARGUMENT,
+        TEXTURE_EXTERNAL_FORWARD_ONLY,
+    ] {
+        for lang_version in [(1, 4), (1, 5)] {
+            let options = spv::Options {
+                lang_version,
+                ..options(binding_map(), false)
+            };
+            let spv = Spv::new(try_compile(source, &options).expect("SPIR-V write failed"));
+            spv.assert_well_typed();
+
+            let resources = resource_variables(&spv);
+            // Three planes and the parameters, plus the sampler if any.
+            assert!(resources.len() >= 4, "{resources:?}");
+            for entry_point in &spv.module.entry_points {
+                let interface: Vec<Word> = entry_point.operands[3..].iter().map(id).collect();
+                for resource in &resources {
+                    assert!(
+                        interface.contains(resource),
+                        "{:?}: %{resource} missing from the interface {interface:?}",
+                        entry_point.operands[2]
+                    );
+                }
+            }
+        }
+    }
+}
+
+/// Writing a single entry point, as wgpu does.
+#[test]
+fn external_texture_single_entry_point() {
+    for (source, entry_point, shader_stage) in [
+        (TEXTURE_EXTERNAL, "fragment_main", naga::ShaderStage::Fragment),
+        (TEXTURE_EXTERNAL, "vertex_main", naga::ShaderStage::Vertex),
+        (TEXTURE_EXTERNAL, "compute_main", naga::ShaderStage::Compute),
+        (TEXTURE_EXTERNAL_ARGUMENT, "fragment_main", naga::ShaderStage::Fragment),
+        (TEXTURE_EXTERNAL_ARGUMENT, "compute_main", naga::ShaderStage::Compute),
+        (TEXTURE_EXTERNAL_FORWARD_ONLY, "main", naga::ShaderStage::Compute),
+    ] {
+        for lang_version in [(1, 1), (1, 4)] {
+            let options = spv::Options {
+                lang_version,
+                ..options(binding_map(), false)
+            };
+            let pipeline_options = spv::PipelineOptions {
+                entry_point: entry_point.to_string(),
+                shader_stage,
+            };
+            let words = try_compile_pipeline(source, &options, Some(&pipeline_options))
+                .expect("SPIR-V write failed");
+            let spv = Spv::new(words);
+            spv.assert_well_typed();
+            assert_eq!(spv.module.entry_points.len(), 1);
+        }
+    }
+}

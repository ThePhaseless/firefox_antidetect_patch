From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: feder-cr <85809106+feder-cr@users.noreply.github.com>
Date: Sun, 1 Nov 2026 09:23:27 +0700
Subject: [PATCH] fix(naga spv-out): Splat the condition of the external
 texture size select

`naga_external_texture_size_query` selected between two `vec2<u32>` values
with a scalar `bool` condition, which is only valid from SPIR-V 1.4 on;
for earlier versions spirv-val rejects it ("Expected vector sizes of Result
Type and the condition to be equal"). Splat the condition to a
`vec2<bool>`.
---
 naga/src/back/spv/image.rs                | 11 ++++++++++-
 naga/tests/naga/spirv_external_texture.rs | 16 ++++++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/naga/src/back/spv/image.rs b/naga/src/back/spv/image.rs
index 88dd9dcc1..bbaff245c 100644
--- a/naga/src/back/spv/image.rs
+++ b/naga/src/back/spv/image.rs
@@ -1644,11 +1644,20 @@ impl super::Writer {
             vec_condition_id,
         ));
 
+        // `OpSelect` with a scalar condition and vector operands requires
+        // SPIR-V 1.4, so splat the condition.
+        let vec_condition_splat_id = self.id_gen.next();
+        block.body.push(Instruction::composite_construct(
+            self.get_vec2_bool_type_id(),
+            vec_condition_splat_id,
+            &[condition_id, condition_id],
+        ));
+
         let result_id = self.id_gen.next();
         block.body.push(Instruction::select(
             vec2u_type_id,
             result_id,
-            condition_id,
+            vec_condition_splat_id,
             params_size_id,
             plane_size_id,
         ));
diff --git a/naga/tests/naga/spirv_external_texture.rs b/naga/tests/naga/spirv_external_texture.rs
index 16e284598..9bf8ccdc5 100644
--- a/naga/tests/naga/spirv_external_texture.rs
+++ b/naga/tests/naga/spirv_external_texture.rs
@@ -263,6 +263,22 @@ impl Spv {
                         ));
                     }
                 }
+                Op::Select => {
+                    // Before SPIR-V 1.4, a vector select needs a vector
+                    // condition of the same size.
+                    let components = |ty: Word| {
+                        let def = self.def(ty);
+                        (def.class.opcode == Op::TypeVector).then(|| def.operands[1].clone())
+                    };
+                    let condition = id(&inst.operands[0]);
+                    let condition_size = components(self.type_of(condition));
+                    let result_size = components(inst.result_type.unwrap());
+                    if condition_size != result_size {
+                        errors.push(format!(
+                            "%{result} = OpSelect: condition size {condition_size:?} != result size {result_size:?}"
+                        ));
+                    }
+                }
                 Op::ImageFetch
                 | Op::ImageQuerySizeLod
                 | Op::ImageQuerySize

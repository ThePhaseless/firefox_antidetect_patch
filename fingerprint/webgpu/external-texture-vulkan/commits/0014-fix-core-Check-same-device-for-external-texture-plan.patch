---
 wgpu-core/src/device/resource.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/wgpu-core/src/device/resource.rs b/wgpu-core/src/device/resource.rs
index 0293711cf..b84536db4 100644
--- a/wgpu-core/src/device/resource.rs
+++ b/wgpu-core/src/device/resource.rs
@@ -2206,6 +2206,8 @@ impl Device {
             .iter()
             .enumerate()
             .map(|(i, plane)| {
+                plane.same_device(self)?;
+
                 if plane.samples != 1 {
                     return Err(CreateExternalTextureError::InvalidPlaneMultisample(
                         plane.samples,

# The gtest of the bundled DirectWrite collection (Windows only). Read by gfx/tests/gtest/moz.build (one include
# line), so the platform condition is ours and not a line of Mozilla's file.

if CONFIG["OS_TARGET"] == "WINNT":
    UNIFIED_SOURCES += ["TestStealthBundledCollection.cpp"]

# Read by StealthGfxGtests.mozbuild: the gtests of the idwr text of Skia.
# Not unified: each one has its own includes and names.

SOURCES += [
    "TestStealthSkiaIdwr.cpp",
    "TestStealthSkiaIdwrThreads.cpp",
    "TestStealthSkiaStrokeLevels.cpp",
    "TestStealthSyntheticBold.cpp",
]

LOCAL_INCLUDES += CONFIG["SKIA_INCLUDES"]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    SOURCES += ["TestStealthIdwrTextVars.cpp"]

# The gtest of the fontconfig font list, and the flags it is built with. Read by gfx/tests/gtest/moz.build (one
# include line), so the platform conditions are ours and not lines of Mozilla's file.

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    UNIFIED_SOURCES += ["TestStealthFcFontList.cpp"]
    CXXFLAGS += CONFIG["CAIRO_FT_CFLAGS"]

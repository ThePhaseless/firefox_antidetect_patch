# The gtests of the font metrics (fontconfig on gtk) and of the text quality (Windows). Read by gfx/tests/gtest/moz.build
# (one include line), so the platform conditions are ours and not lines of Mozilla's file.

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    UNIFIED_SOURCES += ["TestStealthFontMetrics.cpp"]

if CONFIG["OS_TARGET"] == "WINNT":
    UNIFIED_SOURCES += ["TestStealthTextQuality.cpp"]

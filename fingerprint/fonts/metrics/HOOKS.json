 {
  "file": "gfx/thebes/gfxFont.cpp",
  "function": "void gfxFont::SanitizeMetrics(bool aIsBadUnderlineFont) {",
  "kind": "add",
  "form": "anchor",
  "line": "  StealthImposeBundleVMetrics(mFontEntry, GetAdjustedSize(), &mMetrics);  // STEALTH-HOOK(fingerprint/fonts/metrics)",
  "test": "wrapper:tests/test_canvas_measure_text_metrics_e2e.py::test_measure_text_vertical_metrics_are_whole_and_retail",
  "anchor": "if (...) { memset(&mMetrics, 0, sizeof(mMetrics)); return; } (the zero-size early return of gfxFont::SanitizeMetrics)",
  "why": "at the top of the function it is not equivalent (G10/G18): the memset of mMetrics in the early return changes exactly what the hook imposes, and the lines below (ascent/descent/lineGap overrides, clamps) read mMetrics, so a guard or a wrap cannot stand before them"
 },

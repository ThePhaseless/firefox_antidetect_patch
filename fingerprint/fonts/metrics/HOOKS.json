 {
  "file": "gfx/thebes/gfxFT2FontBase.cpp",
  "function": "void gfxFT2FontBase::InitExtraMetrics(gfxFloat aEmHeight,",
  "kind": "add",
  "form": "anchor",
  "line": "  StealthDWriteAveCharWidth(*this, mMetrics);  // STEALTH-HOOK(fingerprint/fonts/metrics)",
  "test": "gtest:StealthFontMetrics.ClearTypeTakesTheOS2AverageUnrounded",
  "anchor": "if (mMetrics.aveCharWidth == 0.0) { mMetrics.aveCharWidth = mMetrics.spaceWidth; }",
  "why": "the hook replaces mMetrics.aveCharWidth, the intermediate value that Mozilla uses on the next line (maxAdvance = max(maxAdvance, aveCharWidth)); a guard at the top would be overwritten by Mozilla's later writes, a wrap of the function cannot undo the max already taken with FreeType's value, and the value is born in several writes"
 },
 {
  "file": "gfx/thebes/gfxFT2FontBase.cpp",
  "function": "bool gfxFT2FontBase::GetFTGlyphExtents(uint16_t aGID, int32_t* aAdvance,",
  "kind": "add",
  "form": "anchor",
  "line": "  StealthDesignAdvance(*this, aGID, bold.x, aAdvance);  // STEALTH-HOOK(fingerprint/fonts/metrics)",
  "test": "gtest:StealthFontMetrics.DesignAdvanceAtAFractionalSize",
  "anchor": "if (aAdvance) { ... *aAdvance = NS_lround(advance * extentsScale); }",
  "why": "the hook needs bold.x, a local born after the glyph is loaded (GetEmboldenStrength is a private member function), and overwrites *aAdvance before the COLR fallback below reads it; a guard at the top or a wrap of the function do not reach that local"
 },

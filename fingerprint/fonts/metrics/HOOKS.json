 {
  "file": "gfx/skia/skia/src/core/SkScalerContext.cpp",
  "function": "void SkScalerContext::getImage(const SkGlyph& origGlyph) {",
  "kind": "add",
  "form": "anchor",
  "line": "    mozilla::gfx::StealthQuantiseGlyphCoverage(*unfilteredGlyph);  // STEALTH-HOOK(fingerprint/fonts/metrics)",
  "test": "wrapper:tests/test_a_screenshot_draws_the_text_of_the_bundled_fonts_as_the_content_does_e2e.py::test_the_text_of_a_bundled_family_is_drawn_by_the_screenshot_as_the_content_drew_it",
  "anchor": "if (!fGenerateImageFromPath) { ... } else { ... } (the block that fills the mask; the line after it is if (fMaskFilter))",
  "why": "a guard at the top or a wrap of getImage cannot run before the mask filter: with fMaskFilter the blur must act on the already quantised mask (unfilteredGlyph), while the output of getImage is already blurred; a wrap of an expression is impossible because the mask is born in three places (DirectWrite, FreeType, from a path)"
 },

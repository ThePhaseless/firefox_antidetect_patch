# The hidden desktop's gtest (Windows only), registered by dom/media/webrtc/moz.build.

if CONFIG["OS_TARGET"] == "WINNT":
    UNIFIED_SOURCES += ["TestStealthWindowInputDesktop.cpp"]
    LOCAL_INCLUDES += ["/third_party/libwebrtc/"]

FINAL_LIBRARY = "xul-gtest"

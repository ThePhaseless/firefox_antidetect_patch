ac_add_options --enable-application=browser

# ============================================================================
# PARITY WITH RETAIL - firefox-21, owner's decision 2026-08-19:
# "we must be as similar as possible to retail, so use everything the retail
# uses".
#
# THIS FILE WAS NOT WRITTEN BY GUESSWORK. It is aligned with the mozconfig
# Mozilla uses to build the win64 release, which is in the tree and can be read:
#     browser/config/mozconfigs/win64/release
#       -> build/mozconfig.win-common          (empty)
#       -> browser/config/mozconfigs/win64/common-win64   (target + clang-cl)
#       -> browser/config/mozconfigs/win64/common-opt
#            --enable-update-channel=${MOZ_UPDATE_CHANNEL}
#            --with-google-location-service-api-keyfile=...
#            --with-google-safebrowsing-api-keyfile=...
#            --with-mozilla-api-keyfile=...
#            export MOZILLA_OFFICIAL=1
#            export MOZ_PACKAGE_JSSHELL=1
#       -> --enable-official-branding
#       -> build/mozconfig.common   (AUTOCLOBBER=1, --enable-js-shell)
#
# The fact that matters: in that chain there is NOT A SINGLE `--disable-*`.
# Crashreporter, background tasks, tests and the three Windows agents are all ON
# in a release. Every `--disable-` we had was a divergence from retail.
# ============================================================================

ac_add_options --disable-debug
ac_add_options --enable-release

# MOZILLA_OFFICIAL is not a plate detail: it is the fact on which six prefs and
# two build gates depend, and TWO of those prefs travel INSIDE the request to
# Google Safe Browsing:
#
#   browser.safebrowsing.id      navclient-auto-ffox  <- official
#                                Firefox              <- us, before this
#   urlclassifier.phishTable     goog-phish-proto     <- official
#                                googpub-phish-proto  <- us, before this
#
# The upstream comment next to them is explicit: "These names are approved by the
# Google Safe Browsing team". Turning Safe Browsing on WITHOUT this flag would
# have sent Google two values declaring us an unofficial build: not an absence,
# a positive tell. That is why the flag comes BEFORE the key.
#
# The other four: browser.dom.window.dump.enabled, devtools.chrome.enabled,
# devtools.debugger.remote-enabled, termsofuse.bypassNotification.
# The two build gates: GetIsOfficialTelemetry (Telemetry.cpp:746-754) and
# MOZ_TELEMETRY_REPORTING, which has `default=mozilla_official`.
export MOZILLA_OFFICIAL=1

# AN OFFICIAL BUILD SAYS WHICH SOURCE IT COMES FROM, and that flag makes it
# official: MOZ_INCLUDE_SOURCE_INFO has `default=mozilla_official`
# (toolkit/moz.configure), and writes repository and changeset into
# source-repo.h and into application.ini / platform.ini (SourceRepository,
# SourceStamp). From a git checkout of this fork the build cannot name them, so
# we declare them: those of the retail of the same version, read from
# browser/config/upstream_source.txt (why, and where they are taken from, is
# explained there; scripts/check_upstream_source.py rejects a file left at the
# previous version).
#
# Up to 151 their absence was not visible: packager.mk extracted the URL with
# awk, which printed nothing, and every binary up to firefox-53 shipped without
# SourceRepository and SourceStamp, which the retail has. Since 157
# make_sourcestamp_file.py rejects the empty header and `mach package` fails.
MOZ_SOURCE_REPO="$(sed -n 's/^repo=//p' "$topsrcdir/browser/config/upstream_source.txt")"
MOZ_SOURCE_CHANGESET="$(sed -n 's/^changeset=//p' "$topsrcdir/browser/config/upstream_source.txt")"
export MOZ_SOURCE_REPO MOZ_SOURCE_CHANGESET

# ONE BUILDID PER BUILD, as in every official Mozilla build, which fixes
# MOZ_BUILD_DATE in its CI. Since 157 the build graph generates buildid.h TWICE
# in one `mach build` (at export and again near the end), and without
# MOZ_BUILD_DATE each generation takes the clock (build/variables.py): in the
# first 157 candidates application.ini said 13:25 and platform.ini 15:11, and
# the core's seal refused to start (platform.ini BuildID different from the
# sealed one). Retail has a single BuildID, in both files.
# A value already in the environment wins: the CI fixes one for the whole run,
# so build and package, and the three legs, say the same BuildID, like the
# retail. scripts/validate_release.py rejects an archive in which the two
# BuildIDs do not match.
mk_add_options "export MOZ_BUILD_DATE=${MOZ_BUILD_DATE:-$(date -u +%Y%m%d%H%M%S)}"

# The channel appears in the update URL and determines MOZ_APP_REMOTINGNAME
# (toolkit/moz.configure:3336-3350): with "release" it is `firefox`, otherwise
# `firefox-<channel>`, and ours was `firefox-default`.
ac_add_options --enable-update-channel=release

# OFFICIAL BRANDING IS OFF, AND IT IS THE OWNER'S DECISION
# (2026-08-20): "if the anti-bot systems cannot detect this you can remove it".
# Here there was `ac_add_options --enable-official-branding`, and it must NOT be
# put back without redoing the measurement below.
#
# THE CONDITION WAS VERIFIED. The flag moves TEN things: one variable
# (`MOZ_APP_DISPLAYNAME`, Firefox -> Nightly, in browser/branding/*/configure.sh)
# and nine prefs in `browser/branding/<brand>/pref/firefox-branding.js`:
#   startup.homepage_welcome_url      about:welcome -> empty
#   app.update.interval               6h -> 24h
#   app.update.checkInstallTime.days  63 -> 2
#   app.update.promptWaitTime / badgeWaitTime   long -> short
#   app.update.url.manual / .details  mozilla.org -> nightly.mozilla.org
#   app.releaseNotesURL x3            present -> absent
#   devtools.selfxss.count            0 -> 5
# NONE is readable by a page: prefs are not exposed to content, and the two with
# a second-order effect (welcome, updates) act on the STARTUP NETWORK, where of
# the twenty hosts involved ZERO are visible to the visited site (network
# parity analysis, section 12).
#
# AND THE UA IS SAFE, which was the real and non-obvious risk. `MOZ_APP_UA_NAME`
# is empty by default (toolkit/moz.configure), so nsHttpHandler falls back on
# `application.ini` Name; if "Nightly" came out of there, `isFirefox` would be
# false (nsHttpHandler.cpp:1064) and the UA would gain " Nightly/151.0" at the
# end. MEASURED on two real artifacts: firefox-20 (without the branding) and
# firefox-21 (with it) BOTH declare Name=Firefox and Vendor=Mozilla. The Name
# field does not come from MOZ_APP_DISPLAYNAME - if it did, firefox-20 would say
# Nightly. The strongest proof: the product shipped today, firefox-20, is
# already built without official branding and passes all the detector gates.
# `RemotingName` is decided by the CHANNEL, not by the branding: with
# --enable-update-channel=release it stays `firefox`, as in the retail.
#
# WHAT WE GAIN: Mozilla's trademark policy does not allow distributing a
# MODIFIED Firefox with the official branding, and this account has already
# been suspended once. `scripts/check_branding.py` rejected the binary as long
# as the line was here.
#
# BUT REMOVING THE LINE IS NOT ENOUGH, AND THE FIRST VERSION OF THIS COMMENT
# SAID IT WAS. Measured on 2026-08-20: after the rebuild `config.status`
# already carried MOZ_APP_DISPLAYNAME='Nightly' and
# MOZ_BRANDING_DIRECTORY='browser/branding/unofficial', and the executable
# STILL declared ProductName=Firefox. The chain is
#     module.ver -> firefox.exe.rc -> firefox.exe.res -> firefox.exe
# and NEITHER of the two generated steps depends on config.status in the
# dependency graph: 64 .rc files and 78 .res files were stuck at the previous
# day. They must be deleted by hand and the build redoes them.
#
# AND DELETING ONLY THE .res IS NOT ENOUGH: at the first attempt I removed those
# and the build regenerated the resources FROM THE OLD .rc, so ProductName stayed
# Firefox and it looked as if the diagnosis was wrong. DELETE BOTH:
#     find <objdir> -name '*.rc' -not -newermt '<reconfiguration date>' -delete
#     find <objdir> -name '*.res' -delete
# Check: ProductName must say Nightly, and `python scripts/check_branding.py
# <exe>` must say PUBLISHABLE. Do not trust the build being green: here it was
# green three times with the wrong branding inside.

# THE THREE API KEYS ARE NO LONGER COMPILED INTO THE BINARY.
# Owner's decision, 2026-08-20: "I want to move these values to the core, find a
# way so that every time firefox starts it reads them and sets them taking them
# from the core, as we basically do for everything else the core generates".
#
# They used to be here, and must NOT be put back:
#   APIKEYDIR="${APIKEYDIR:-C:/builds}"   (and /builds on Linux)
#   ac_add_options --with-google-location-service-api-keyfile=${APIKEYDIR}/gls-gapi.data
#   ac_add_options --with-google-safebrowsing-api-keyfile=${APIKEYDIR}/sb-gapi.data
#   ac_add_options --with-mozilla-api-keyfile=${APIKEYDIR}/mozilla-desktop-geoloc-api.key
#
# WHAT WAS REMOVED ALONG WITH THEM, because a single piece would not have helped:
#   toolkit/modules/AppConstants.sys.mjs  the three @MOZ_..._API_KEY@ entries
#   toolkit/modules/moz.build             the three DEFINES that fed them
# and the only reader, URLFormatter.sys.mjs, now reads the
# `zoom.stealth.apikey.*` prefs instead of the constants (stealthDeclaredApiKey).
#
# WHY: it is engine rule 1, not a whim: "the core declares, the engine
# obeys... even at the cost of adding prefs in the browser and recompiling it".
# The domain is finite and known - three keys - so rule 2 is satisfied. A
# compiled constant next to a declaration by the core would be two sources for
# the same value, which rule 7 forbids.
#
# AND THE FAILURE MODE THIS REMOVES was asymmetric, which is what made it
# dangerous: with unreadable keyfiles the two GOOGLE keys fell back SILENTLY on
# the sentinel and only the Mozilla one was fatal. Measured on 2026-08-20: with
# the wrong paths configure complained ONLY about the third, so the build would
# have passed green without keys and without saying so. Now the absence is a
# console error at every use.

# HERE THERE WERE SIX `--disable-`, AND EACH ONE WAS A DIVERGENCE.
# All removed, because Mozilla's release has none:
#
#   --disable-crashreporter        the retail has it (default=crashreporter_default)
#   --disable-backgroundtasks      the retail has it
#   --disable-tests                the retail builds them (moz.configure:91, default on)
#   --disable-default-browser-agent \
#   --disable-maintenance-service   > all three ON in a win64 release
#   --disable-update-agent         /
#
# The Windows agents do not modify the machine just by being compiled: it is the
# INSTALLER that registers services and scheduled tasks, and we ship an archive.
# Compiling them aligns the package file list with the retail without
# installing anything.
#
# `MOZ_REQUIRE_SIGNING` was exported EMPTY, that is off. The default is
# `require_signing` and on the release channel it is ON (toolkit/moz.configure:2034).
# Consequence to know: with signing required, an unsigned extension does not
# load. Juggler is compiled in and is not an extension, so the product path does
# not change; it changes for those who load their own extensions.

# THE UPDATER IS THE RETAIL ONE (2026-10-30, owner's decision:
# "as official, without installing"). build/moz.configure/update-programs.configure
# is again Mozilla's file: updater, maintenance service and update
# agent are compiled and packaged as in the win64 release, and the
# check towards aus5.mozilla.org starts with the same timer and the same URL.
# What follows the response is rejected by toolkit/mozapps/update/StealthUpdate.sys.mjs
# (stillborn/updater): no update offered, no download, no scheduled
# task on the machine. From 2026-08-31 until today the options were
# REMOVED from the file, and the build did not do the check that the retail does.
#
# The MAR channels are those of the retail (release update-settings.ini:
# ACCEPTED_MAR_CHANNEL_IDS=firefox-mozilla-release); without them the file would
# come out empty. Mozilla passes them from the environment of its CI, we from here.
export MAR_CHANNEL_ID=firefox-mozilla-release
export ACCEPTED_MAR_CHANNEL_IDS=firefox-mozilla-release
#
# The updater timings (interval, startup check for old builds,
# badge, warnings) live in the branding, and ours is unofficial: its lines
# carry the values of the official branding (browser/branding/unofficial/pref/
# firefox-branding.js, STEALTH-HOOK(stillborn/updater)).

ac_add_options --enable-bootstrap

# Bundle the Windows core font set on EVERY desktop OS. bundled_fonts_default in
# toolkit/moz.configure enables MOZ_BUNDLED_FONTS only for Windows + Linux, so
# macOS defaulted OFF: the bundle never loaded and our bundle-only block-at-birth
# hooks (behind #ifdef MOZ_BUNDLED_FONTS) were compiled out, leaking host fonts.
# Enabling it explicitly is a no-op on Win/Linux (already on) and turns the
# self-contained font persona on for macOS. The font files are packaged on cocoa
# already (browser/fonts/moz.build).
#
# This is the ONLY deliberate divergence left from the release mozconfig, and it
# is a stealth function, not a suppression: it adds fonts, it does not remove any.
ac_add_options --enable-bundled-fonts

# SIMD in the Rust code (text decoding and others), as the retail 157 is built
# on every platform (its about:buildconfig). Without it every value a page reads
# is the same and the operations behind them run at another speed.
# scripts/toolchain_parity.py refuses a build that drops it again.
ac_add_options --enable-rust-simd

# The NSIS installer stays out: it is a separate ARTIFACT, not a property of the
# running browser. The retail ships it, we ship an archive, and neither a page
# nor the network can tell the two apart. The js shell (which Mozilla packages
# with MOZ_PACKAGE_JSSHELL) stays out for the same reason.
mk_add_options MOZ_INSTALLER=0
mk_add_options MOZ_AUTOMATION_INSTALLER=0

# HTTP/3 towards Google: the proxy does not implement UDP ASSOCIATE, so QUIC does
# not get through and will not as long as traffic exits through these proxies.
#
# BUT IT IS NOT A GAP OF OURS, and the line that was here said the opposite.
# It had been written by comparing OUR proxied path with a DIRECT retail, which
# mixes "we are different" with "the proxy is different". Measured on
# 2026-08-19 with three arms on the same pinned exit and the same tool: the
# DIRECT retail uses h3, the retail BEHIND THE PROXY does not, we behind the
# proxy do not, and all three receive `alt-svc: h3=":443"` from Google. So it
# does not separate us from a retail that exits from the same place, and there
# is nothing to recover.
# The full account is in the network parity analysis, section 9.

# ============================================================================
# ONE CONFIGURATION FOR BOTH MACHINES (2026-08-22)
# ============================================================================
#
# Until today the Linux side had its own mozconfig, and it was not a subset: it
# carried TEN more lines, all deactivations, and each one was a step away from
# the retail. They were all removed, at the owner's request: "turn on telemetry
# everywhere, it must look as much as possible like a Windows Firefox".
# The direction is that of rule 4 - Linux is moved to Windows, never the
# opposite.
#
#   LINE REMOVED FROM THE LINUX SIDE   WHAT IT DID            THE RETAIL
#   --disable-crashreporter            no crash reporter      has it
#   mk MOZ_CRASHREPORTER=0             same                   has it
#   --disable-updater                  no updater             has it
#   --disable-backgroundtasks          no background tasks    has it
#   mk MOZ_TELEMETRY_REPORTING=0       telemetry off          on
#   mk MOZ_DATA_REPORTING=0            same                   on
#   mk MOZ_SERVICES_HEALTHREPORT=0     same                   on
#   export MOZ_REQUIRE_SIGNING=        unsigned extensions    requires signing
#   --disable-tests                    smaller build          not observable
#   case uname -s -> 3 Windows agents  already done by CI     -
#
# None was a platform necessity: Windows builds without all ten, and has
# always done so.
#
# WHY ONE FILE AND NOT TWO PER-OS. For a few hours, today, this file was a
# dispatcher that chose `.mozconfig-win` or `.mozconfig-linux` by looking at
# `uname`. With the two configurations now IDENTICAL those two files would be
# equal copies, that is exactly the place where someone adds an option on one
# side only and the divergence starts again. The dispatcher solved the wrong
# problem: the defect was not "a single file", it was "a single file that
# contained the configuration of ONE of the two machines".
#
# AND THIS FILE ALSO DECIDES WHAT THE CI BUILDS. `release.yml` has no mozconfig
# of its own: it does `test -f .mozconfig` and APPENDS the per-target options
# to it (`--target=`, the macOS SDK, the three agents on Windows, MOZ_OBJDIR).
# So a line written here is valid for all five legs. Before today `origin` had
# the LINUX version, so all five built NON official; from here on they all build
# official.
#
# CHANGING THIS FILE FORCES A RECONFIGURE, that is a full rebuild on BOTH
# machines (3-4 hours, not the 15-60 minutes of an incremental one). It is not a
# change to make on a release day.
#
# AND THE FIRST LINUX BUILD WITH `MOZILLA_OFFICIAL` IS A MEASUREMENT, NOT A
# FORMALITY: that flag turns off `browser.dom.window.dump.enabled`, and the
# `Juggler listening to the pipe` line goes through it. Without the remedy in
# `juggler/components/Juggler.js` every `launch` times out with the pipe working
# perfectly and no error anywhere. The remedy is in this tree, and is verified
# present on both checkouts - but it was MEASURED only on Windows. The first
# thing to try after the Linux build is a `launch`.

# ============================================================================
# BUILD SPEED (2026-08-22)
# ============================================================================
#
# Until today there was NO compilation cache: neither ccache nor sccache, and no
# declared parallelism. It was the biggest lever available and it had never been
# touched.
#
# sccache instead of ccache because it also caches Rust artifacts, which in
# Firefox are a large slice. The Mozilla documentation: since 0.7.4 the
# preprocessor-cache mode is the default and "decreases the build time by a
# factor of 2 to 3" with a warm cache. The FIRST build will be SLOWER, because of
# the population work: the gain comes from the second one on, so this choice
# must not be judged on the first run.
#
# The name and nothing else, without a path: `sccache` is in the PATH of both
# machines (Windows ~/.cargo/bin, Linux ~/.local/bin) and the path is a
# property of the machine, not of the source - writing it here would put back in
# this file a per-OS difference, which is exactly what was removed on 2026-08-22.
ac_add_options --with-ccache=sccache

# --with-ccache covers C/C++ but NOT Rust: that goes through RUSTC_WRAPPER, which
# build/moz.configure/toolchain.configure treats as a separate option.
mk_add_options 'export RUSTC_WRAPPER=sccache'

# The sccache default is 10 GB, which for a Firefox tree fills up and evicts the
# entries that are needed, that is it defeats the cache. Here there is room.
mk_add_options 'export SCCACHE_CACHE_SIZE=50G'

# 16 cores on this machine. The Mozilla documentation says the (diminishing)
# returns go up to 1.5-2.0 times the number of cores, so 24 is the low end of
# that range. Not 32: this file is valid for BOTH machines and WSL sees 31 GB of
# RAM against the host's 63, so the number is dictated by the tighter machine.
# If one day the two diverge, the right place is NOT a per-OS branch in here: it
# is MOZ_PARALLEL_BUILD in the environment of the single machine, which wins over
# this line.
mk_add_options MOZ_PARALLEL_BUILD=32

# DEBUG SYMBOLS ARE PRODUCED BY DEFAULT EVEN IN OPT BUILDS, and they are the
# biggest cost of a cold build: more work for the compiler and a much heavier
# libxul link.
#
# Removing them does not take us away from what we ship - it brings us CLOSER.
# `release.yml` already appends `--disable-debug-symbols` to all five legs, so
# the published assets never had them: it was the LOCAL builds that were
# different, besides being slower.
#
# The price, and it is real: a local crash will not have a symbolized stack. For
# a diagnosis that needs them the line is put back by hand for that build.
ac_add_options --disable-debug-symbols
